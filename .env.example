# Boxel CLI Configuration
# Copy this file to .env and fill in your credentials

# ===========================================
# PRODUCTION (app.boxel.ai)
# ===========================================
# MATRIX_URL=https://matrix.boxel.ai
# MATRIX_USERNAME=your-username
# MATRIX_PASSWORD=your-password
# REALM_SERVER_URL=https://app.boxel.ai/

# ===========================================
# STAGING (for development/testing)
# ===========================================
# MATRIX_URL=https://matrix-staging.stack.cards
# MATRIX_USERNAME=your-username
# MATRIX_PASSWORD=your-password
# REALM_SERVER_URL=https://realms-staging.stack.cards/

# Uncomment ONE of the sections above and fill in your credentials
# Your username/password are the same as your Boxel web login
