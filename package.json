{
  "name": "boxel-cli",
  "version": "1.0.0",
  "description": "CLI for bidirectional sync between local directories and Boxel workspaces",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "boxel": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "boxel",
    "cardstack",
    "workspace",
    "sync",
    "cli",
    "bidirectional"
  ],
  "author": "Cardstack Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cardstack/boxel-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cardstack/boxel-cli/issues"
  },
  "homepage": "https://github.com/cardstack/boxel-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "ignore": "^5.3.2",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@toast-ui/toastmark": "^0.0.1-alpha.1",
    "@types/node": "^20.14.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "entities": "^7.0.1",
    "esbuild": "^0.27.3",
    "eslint": "^8.57.0",
    "mdurl": "^2.0.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.0",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.11.0",
    "prosemirror-view": "^1.41.6",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
